# Copy to .env and fill in. `docker compose` reads this file automatically.

# Model the active skin expects. Used by the `model-init` helper to pre-pull.
OLLAMA_MODEL=exaone3.5:7.8b

# Cartesia Sonic TTS — only needed when a skin sets tts_backend="cartesia".
# Get a key at https://play.cartesia.ai/  (bring-your-own-key).
# Read by the HOST Python process (export it in your shell too); listed here
# so all memvox config lives in one place.
CARTESIA_API_KEY=
